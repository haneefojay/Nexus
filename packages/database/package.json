{
  "name": "@nexus/database",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "nexus-source": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "drizzle-kit": "0.31.11",
    "typescript": "^5.9.2",
    "vitest": "4.1.11"
  }
}
