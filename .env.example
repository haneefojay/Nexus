# Application
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# PostgreSQL / PostGIS
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_local_only
DATABASE_URL=postgresql://nexus:nexus_local_only@localhost:5432/nexus

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# S3-compatible local storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nexus-local
S3_ACCESS_KEY=nexus
S3_SECRET_KEY=nexus_local_only
S3_FORCE_PATH_STYLE=true

# Authentication
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001

# Maps (public browser key; use a restricted development key)
NEXT_PUBLIC_MAPTILER_API_KEY=

# Development email
EMAIL_FROM=NEXUS <no-reply@nexus.local>
SMTP_HOST=localhost
SMTP_PORT=1025

# Optional observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
