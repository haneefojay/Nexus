{
  "name": "@nexus/worker",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=nexus-source src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "benchmark:phase5": "tsx --conditions=nexus-source src/performance-benchmark.ts"
  },
  "dependencies": {
    "@nexus/config": "workspace:*",
    "@nexus/contracts": "workspace:*",
    "@nexus/database": "workspace:*",
    "@nexus/domain": "workspace:*",
    "@nexus/storage": "workspace:*",
    "bullmq": "5.58.5",
    "csv-parse": "6.1.0",
    "nodemailer": "10.0.12",
    "@nexus/observability": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/nodemailer": "8.0.2",
    "tsx": "4.20.5",
    "typescript": "^5.9.2",
    "vitest": "4.1.11"
  }
}
