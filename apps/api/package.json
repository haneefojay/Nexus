{
  "name": "@nexus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/static": "10.1.5",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-fastify": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "@nexus/auth": "workspace:*",
    "@nexus/config": "workspace:*",
    "@nexus/contracts": "workspace:*",
    "@nexus/database": "workspace:*",
    "@nexus/validation": "workspace:*",
    "bullmq": "5.58.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fastify": "5.12.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.6",
    "@types/node": "^24.5.2",
    "tsx": "4.20.5",
    "typescript": "^5.9.2",
    "vitest": "4.1.11"
  }
}
